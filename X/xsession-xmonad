#!/bin/sh
# ~/.xsession-xmonad

# DBus environment
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP DESKTOP_SESSION
fi

# Pre-warm daemons that gnome-session normally starts eagerly
systemctl --user start dconf.service at-spi-dbus-bus.service gvfs-daemon.service gvfs-udisks2-volume-monitor.service &

# Keyboard layouts
setxkbmap -option caps:escape -option compose:ralt

# GNOME system daemons
/usr/libexec/gsd-xsettings &
/usr/libexec/gsd-media-keys &

# Compositor
picom &

# Desktop portals
systemctl --user import-environment DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP
systemctl --user start xdg-desktop-portal.service xdg-desktop-portal-gtk.service &

# Bluetooth
blueman-applet &

# Status bar
GTK_THEME=Yaru:dark "$HOME/.local/bin/taffybar" &

# Notifications
dunst &

# Window manager
exec "$HOME/.local/bin/xmonad"
